# TradeArena Environment Variables Template

# Application
NODE_ENV=development
PORT=3333
FRONTEND_PORT=4444
FRONTEND_URL=http://localhost:4444
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradearena?schema=public"

# Redis & Queues (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Market Data Provider
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@tradearena.local
ADMIN_PASSWORD=AdminSecurePass123!
ADMIN_NAME="TradeArena Super Admin"
