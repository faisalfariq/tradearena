generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTICIPANT
}

enum TournamentStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EntrySource {
  MANUAL
  MARKET_OPEN
  SUBMISSION_PRICE
  OTHER_TOURNAMENT_RULE
}

enum PickStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CandleAmbiguityPolicy {
  CONSERVATIVE_LOSS_FIRST
  HIGH_FIRST
  LOW_FIRST
  REVIEW_REQUIRED
}

enum GapPolicy {
  ACTUAL_FIRST_VALID_LEVEL
  THEORETICAL_THRESHOLD
}

enum EvaluationStatus {
  PENDING
  PENDING_DATA
  PROCESSING
  COMPLETED
  REVIEW_REQUIRED
  OVERRIDDEN
}

enum ExitReason {
  INITIAL_CL
  TRAILING_STOP
  MARKET_CLOSE
  MANUAL_OVERRIDE
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  role          Role           @default(ADMIN)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  overrides     EvaluationOverride[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model Tournament {
  id           String                   @id @default(uuid())
  name         String
  description  String?
  startDate    DateTime                 @map("start_date")
  endDate      DateTime                 @map("end_date")
  status       TournamentStatus         @default(UPCOMING)
  timezone     String                   @default("Asia/Jakarta")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  rules        TournamentRule?
  participants TournamentParticipant[]
  picks        StockPick[]
  syncRuns     MarketSyncRun[]

  @@map("tournaments")
}

model TournamentRule {
  id                     String                @id @default(uuid())
  tournamentId           String                @unique @map("tournament_id")
  tournament             Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  initialStopPct         Decimal               @default(0.03) @map("initial_stop_percentage") @db.Decimal(5, 4)
  trailingStopPct        Decimal               @default(0.03) @map("trailing_stop_percentage") @db.Decimal(5, 4)
  candleAmbiguityPolicy  CandleAmbiguityPolicy @default(CONSERVATIVE_LOSS_FIRST) @map("candle_ambiguity_policy")
  gapPolicy              GapPolicy             @default(ACTUAL_FIRST_VALID_LEVEL) @map("gap_policy")
  priceFractionPolicy    String                @default("IDX_STANDARD_V1") @map("price_fraction_policy")
  pointsRule             String                @default("PERCENTAGE_RETURN_V1") @map("points_rule")
  calculationRuleVersion String                @default("v1.0.0") @map("calculation_rule_version")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  @@map("tournament_rules")
}

model Participant {
  id          String                   @id @default(uuid())
  name        String
  email       String?                  @unique
  phoneNumber String?                  @map("phone_number")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  tournaments TournamentParticipant[]
  picks       StockPick[]

  @@map("participants")
}

model TournamentParticipant {
  id            String      @id @default(uuid())
  tournamentId  String      @map("tournament_id")
  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participantId String      @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now()) @map("joined_at")

  @@unique([tournamentId, participantId])
  @@map("tournament_participants")
}

model Stock {
  id        String      @id @default(uuid())
  symbol    String      @unique
  name      String
  exchange  String      @default("IDX")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  picks     StockPick[]
  candles   IntradayCandle[]

  @@map("stocks")
}

model StockPick {
  id             String            @id @default(uuid())
  tournamentId   String            @map("tournament_id")
  tournament     Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participantId  String            @map("participant_id")
  participant    Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  stockId        String            @map("stock_id")
  stock          Stock             @relation(fields: [stockId], references: [id])
  tradingDate    DateTime          @map("trading_date") @db.Date
  entryPrice     Decimal           @map("entry_price") @db.Decimal(12, 4)
  entryTimestamp DateTime?         @map("entry_timestamp")
  entrySource    EntrySource       @default(MARKET_OPEN) @map("entry_source")
  status         PickStatus        @default(CONFIRMED)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  evaluations    TradeEvaluation[]

  @@unique([tournamentId, participantId, tradingDate, stockId])
  @@map("stock_picks")
}

model IntradayCandle {
  id          String   @id @default(uuid())
  stockId     String   @map("stock_id")
  stock       Stock    @relation(fields: [stockId], references: [id])
  symbol      String
  tradingDate DateTime @map("trading_date") @db.Date
  timestamp   DateTime
  open        Decimal  @db.Decimal(12, 4)
  high        Decimal  @db.Decimal(12, 4)
  low         Decimal  @db.Decimal(12, 4)
  close       Decimal  @db.Decimal(12, 4)
  volume      BigInt?
  provider    String   @default("canonical")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([symbol, timestamp, provider])
  @@index([symbol, tradingDate])
  @@map("intraday_candles")
}

model MarketSyncRun {
  id           String           @id @default(uuid())
  tournamentId String           @map("tournament_id")
  tournament   Tournament       @relation(fields: [tournamentId], references: [id])
  tradingDate  DateTime         @map("trading_date") @db.Date
  status       SyncStatus       @default(PENDING)
  totalSymbols Int              @default(0) @map("total_symbols")
  syncedCount  Int              @default(0) @map("synced_count")
  failedCount  Int              @default(0) @map("failed_count")
  errorMessage String?          @map("error_message")
  startedAt    DateTime?        @map("started_at")
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  items        MarketSyncItem[]

  @@map("market_sync_runs")
}

model MarketSyncItem {
  id           String        @id @default(uuid())
  syncRunId    String        @map("sync_run_id")
  syncRun      MarketSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  symbol       String
  status       SyncStatus    @default(PENDING)
  candlesCount Int           @default(0) @map("candles_count")
  errorMessage String?       @map("error_message")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([syncRunId, symbol])
  @@map("market_sync_items")
}

model TradeEvaluation {
  id                    String                   @id @default(uuid())
  pickId                String                   @map("pick_id")
  pick                  StockPick                @relation(fields: [pickId], references: [id], onDelete: Cascade)
  status                EvaluationStatus         @default(PENDING)
  entryPrice            Decimal                  @map("entry_price") @db.Decimal(12, 4)
  exitPrice             Decimal?                 @map("exit_price") @db.Decimal(12, 4)
  exitTimestamp         DateTime?                @map("exit_timestamp")
  exitReason            ExitReason?              @map("exit_reason")
  highestPrice          Decimal?                 @map("highest_price") @db.Decimal(12, 4)
  maxFloatingReturn     Decimal?                 @map("max_floating_return") @db.Decimal(8, 4)
  theoreticalThreshold  Decimal?                 @map("theoretical_threshold") @db.Decimal(12, 4)
  actualExitPrice       Decimal?                 @map("actual_exit_price") @db.Decimal(12, 4)
  realizedReturn        Decimal?                 @map("realized_return") @db.Decimal(8, 4)
  calculationVersion    String                   @default("v1.0.0") @map("calculation_version")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  evidence              TradeEvaluationEvidence?
  pointsResult          PointsResult?
  override              EvaluationOverride?

  @@unique([pickId, calculationVersion])
  @@map("trade_evaluations")
}

model TradeEvaluationEvidence {
  id                   String          @id @default(uuid())
  evaluationId         String          @unique @map("evaluation_id")
  evaluation           TradeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  marketDataProvider   String          @map("market_data_provider")
  marketDataDate       DateTime        @map("market_data_date") @db.Date
  candleCount          Int             @map("candle_count")
  priceFractionVersion String          @map("price_fraction_version")
  detailsJson          Json            @map("details_json")
  createdAt            DateTime        @default(now()) @map("created_at")

  @@map("trade_evaluation_evidence")
}

model PointsResult {
  id               String          @id @default(uuid())
  evaluationId     String          @unique @map("evaluation_id")
  evaluation       TradeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  points           Decimal         @db.Decimal(10, 4)
  pointsRule       String          @map("points_rule")
  pointsRuleVersion String         @map("points_rule_version")
  createdAt        DateTime        @default(now()) @map("created_at")

  @@map("points_results")
}

model EvaluationOverride {
  id                String          @id @default(uuid())
  evaluationId      String          @unique @map("evaluation_id")
  evaluation        TradeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id])
  originalExitPrice Decimal?        @map("original_exit_price") @db.Decimal(12, 4)
  originalReturn    Decimal?        @map("original_return") @db.Decimal(8, 4)
  originalPoints    Decimal?        @map("original_points") @db.Decimal(10, 4)
  overrideExitPrice Decimal         @map("override_exit_price") @db.Decimal(12, 4)
  overrideReturn    Decimal         @map("override_return") @db.Decimal(8, 4)
  overridePoints    Decimal         @map("override_points") @db.Decimal(10, 4)
  reason            String
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("evaluation_overrides")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
